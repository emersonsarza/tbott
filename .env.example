# Optional — leave blank for showcase / testing (no booking emails)
# When RESEND_API_KEY is set, appointment requests are emailed for real.
RESEND_API_KEY=
BOOKING_TO_EMAIL=tbottinc1@gmail.com
BOOKING_FROM_EMAIL=The Bark of the Town <appointments@tbottinc.com>
# Optional — CC a second inbox on every booking email (e.g. tbottinc@gmail.com)
BOOKING_CC_EMAIL=

# Public site origin for Open Graph / canonical URLs.
# Showcase VPS: https://tbott.by1002.com
# Production:   https://tbottinc.com
NEXT_PUBLIC_SITE_URL=https://tbott.by1002.com

# Optional production rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
